        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "data_quality_problems",
      "displayName": "Data quality problems",
      "config": {
        "version": "1.1",
        "source": "SELECT 'Rejected rows' AS problem_type, rejected_rows AS problem_count FROM edtech_catalog.learning.gold_data_quality UNION ALL SELECT 'Duplicate rows' AS problem_type, duplicate_rows AS problem_count FROM edtech_catalog.learning.gold_data_quality\n",
        "dimensions": [
          {
            "name": "problem_type",
            "expr": "source.problem_type"
          }
        ],
        "measures": [
          {
            "name": "problem_count",
            "expr": "SUM(source.problem_count)"
          }
        ]
      }
    }
  ],
