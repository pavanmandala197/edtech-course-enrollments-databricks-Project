    {
      "name": "37194048",
      "displayName": "gold_data_quality",
      "config": {
        "version": "1.1",
        "source": "edtech_catalog.learning.gold_data_quality",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
